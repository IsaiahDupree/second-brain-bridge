# SecondBrainBridge configuration. Copy to .env.local and fill in.
# NEVER commit .env.local (it is gitignored). Placeholders only in this file.

# ── Server (set these on Vercel for the hosted relay; local for self-hosting) ──
# Supabase project backing the KV (nb_* RPCs). Shared across the Mac Bridge family.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret used to sign OAuth/session/agent JWTs. Generate: openssl rand -hex 32
JWT_SECRET=change-me

# Reviewer/demo account password (email is reviewer@secondbrainbridge.demo).
DEMO_PASSWORD=change-me

# ── Stripe (Pro subscription billing) ──
# Leave these UNSET to run fully free / self-host (getPlan returns 'pro' for
# everyone when billing is off). Set all three to enable the paid Pro gate.
# Use TEST-mode keys (sk_test_… / a test price_…) until launch.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_PRO=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Absolute base used to build Stripe success/cancel + /upgrade URLs.
PUBLIC_BASE_URL=https://secondbrainbridge.vercel.app

# ── Kit / e2e (kit/register-connector.mjs, test/e2e-oauth.mjs) ──
NB_SERVER=https://secondbrainbridge.vercel.app
# The SecondBrainBridge account the connector signs in as (the demo account).
NB_EMAIL=reviewer@secondbrainbridge.demo
NB_PASSWORD=your-secondbrainbridge-password
